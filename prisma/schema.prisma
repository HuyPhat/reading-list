generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ReadingItem {
  id        String   @id @default(cuid())
  title     String
  author    String
  url       String?
  notes     String?
  status    String   @default("TO_READ")
  tags      Tag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id    String        @id @default(cuid())
  name  String        @unique
  items ReadingItem[]
}
